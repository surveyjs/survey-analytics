{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2019"
    ],
    "sourceMap": true,
    "importHelpers": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": [
      "vitest/globals"
    ]
  },
  "exclude": [
    "src/entries/**/*.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}